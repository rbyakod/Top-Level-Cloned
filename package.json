{
  "name": "agent-os-smart-router",
  "version": "1.0.0",
  "description": "Smart Router and Orchestration System for Agent OS v2.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "dev": "tsx src/index.ts",
    "dev:ts-node": "ts-node src/index.ts",
    "demo": "tsx src/smart-router/integration-demo.ts",
    "test:integration": "tsx src/smart-router/test/integration-test.ts"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts"
    ]
  }
}
